# Copy to .env.local and fill in. Never commit real values.

# App
APP_NAME=AxoriOS                     # Product name shown in the UI
NEXT_PUBLIC_APP_URL=                 # http://localhost:3000 locally; production domain on Vercel

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=            # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Public anon key, limited by row-level security
SUPABASE_SERVICE_ROLE_KEY=           # Server only; bypasses row-level security
SUPABASE_PROJECT_REF=                # Used by the Supabase CLI
SUPABASE_DB_PASSWORD=                # Used by the Supabase CLI
SUPABASE_ACCESS_TOKEN=               # Personal access token for the Supabase CLI

# Gemini (Google AI Studio)
GOOGLE_GENERATIVE_AI_API_KEY=        # API key
GEMINI_TEXT_MODEL=                   # Flash-tier model ID for the agent
GEMINI_IMAGE_MODEL=                  # Image model ID for logos and creatives
IMAGE_PROVIDER=template              # template (alias og) = on-brand graphics, no AI model; cloudflare-flux (alias cloudflare) = Flux paints the background, code draws words + price
CLOUDFLARE_ACCOUNT_ID=               # Cloudflare account ID (dashboard > Workers AI); needed when IMAGE_PROVIDER=cloudflare-flux
CLOUDFLARE_AI_TOKEN=                 # API token with Workers AI: Read permission
CLOUDFLARE_IMAGE_MODEL=              # e.g. @cf/black-forest-labs/flux-1-schnell (JSON input) or a flux-2 model (multipart input)

# Agent text model
TEXT_MODEL_PROVIDER=google           # google or groq
GROQ_API_KEY=                        # Needed when the provider is groq
GROQ_TEXT_MODEL=                     # Groq model ID with tool calling; needed when the provider is groq

# PayPal (developer.paypal.com; sandbox only)
PAYPAL_ENV=sandbox                   # Must stay sandbox
PAYPAL_CLIENT_ID=                    # Sandbox REST app client ID
PAYPAL_CLIENT_SECRET=                # Sandbox REST app secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=        # Same value as PAYPAL_CLIENT_ID, for the browser buttons
PAYPAL_WEBHOOK_ID=                   # ID of the webhook registered on the production URL
PAYPAL_SANDBOX_BUYER_EMAIL=          # Scripts and README only: the sandbox Personal account
PAYPAL_SANDBOX_BUYER_PASSWORD=       # Scripts and README only

# WhatsApp through Twilio: dormant. Set WHATSAPP_ENABLED=true and the TWILIO_* keys to switch it on
WHATSAPP_ENABLED=false               # Off by default; the webhook returns 404
TWILIO_ACCOUNT_SID=                  # Account SID
TWILIO_AUTH_TOKEN=                   # Auth token; also verifies webhook signatures
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # The shared Sandbox number

# WhatsApp through Kapso (spec v2). off | kapso | twilio
WHATSAPP_PROVIDER=off                # kapso needs the three keys below
KAPSO_API_KEY=                       # Kapso project API key
KAPSO_PHONE_NUMBER_ID=               # Kapso sandbox phone number ID
KAPSO_WEBHOOK_SECRET=                # openssl rand -hex 32; the webhook path token /api/webhooks/kapso/<secret>

# Demo adapters until developer accounts exist. off | demo
META_PROVIDER=demo                   # Facebook, Instagram, Messenger
TIKTOK_PROVIDER=demo                 # TikTok
GOOGLE_PROVIDER=demo                 # Google Business Profile

# Analytics (AG Studio)
AG_STUDIO_ENABLED=true               # false falls back to the basic dashboard
AG_STUDIO=                           # Optional licence key; blank shows the watermark

# Zapier MCP: one approval-gated seller connection
ZAPIER_ENABLED=false                 # true needs the two keys below
ZAPIER_MCP_URL=                      # Server URL from mcp.zapier.com
ZAPIER_MCP_TOKEN=                    # Bearer token for that server

# Scripts only
SANDBOX_BUYERS=                      # JSON list [{"email":"..","password":"..","country":"GB"}] of sandbox personal buyers for scripts/sandbox-orders.mts
SEED=20261109                        # Fixed PRNG seed for scripts/seed-v2.mts

# Telegram
TELEGRAM_BOT_TOKEN=                  # From @BotFather
TELEGRAM_BOT_USERNAME=               # The bot's @username without the @; store chat buttons link to it
TELEGRAM_CHANNEL_ID=                 # @channel_username; the bot must be a channel admin
DEMO_STORE_SLUG=demo                 # The one store allowed to post to that channel and sync to the Shopify dev store
TELEGRAM_WEBHOOK_SECRET=             # openssl rand -hex 32; Telegram accepts only A-Z a-z 0-9 _ -

# Shopify (dev store)
SHOPIFY_STORE_DOMAIN=                # your-store.myshopify.com
SHOPIFY_CLIENT_ID=                   # Dev Dashboard app client ID; the app must be installed on the store
SHOPIFY_CLIENT_SECRET=               # Dev Dashboard app client secret

# Inngest (only needed on the deployed app)
INNGEST_EVENT_KEY=                   # Event key
INNGEST_SIGNING_KEY=                 # Signing key

# Random secrets (openssl rand -base64 32)
ENCRYPTION_KEY=                      # Encrypts Shopify tokens at rest
DRAFT_PREVIEW_SECRET=                # Signs 24 h draft preview tokens

# Demo account for judges
DEMO_SELLER_EMAIL=                   # Demo seller login email
DEMO_SELLER_PASSWORD=                # Demo seller login password
